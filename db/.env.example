# One-off database administration only. Do NOT pass this environment to the API.
# Copy to db/.env, use independently generated passwords, and keep it out of Git.
IDENTITY_ADMIN_DATABASE_URL='postgres://BOOTSTRAP_ADMIN:URL_ENCODED_ADMIN_PASSWORD@127.0.0.1:5433/postgres?sslmode=disable'
INCIDENT_ADMIN_DATABASE_URL='postgres://BOOTSTRAP_ADMIN:URL_ENCODED_ADMIN_PASSWORD@127.0.0.1:5434/postgres?sslmode=disable'

# Raw passwords consumed by psql bootstrap scripts; at least 16 characters each.
# These must match the percent-encoded passwords in the connection URLs below
# and in the API's separate .env. Replace every placeholder before use.
IDENTITY_MIGRATION_PASSWORD='REPLACE_WITH_UNIQUE_MIGRATION_PASSWORD'
IDENTITY_RUNTIME_PASSWORD='REPLACE_WITH_UNIQUE_RUNTIME_PASSWORD'
INCIDENT_MIGRATION_PASSWORD='REPLACE_WITH_ANOTHER_MIGRATION_PASSWORD'
INCIDENT_RUNTIME_PASSWORD='REPLACE_WITH_ANOTHER_RUNTIME_PASSWORD'

IDENTITY_MIGRATION_DATABASE_URL='postgres://identity_migrator:URL_ENCODED_MIGRATION_PASSWORD@127.0.0.1:5433/cyberguard_identity?sslmode=disable'
INCIDENT_MIGRATION_DATABASE_URL='postgres://incidents_migrator:URL_ENCODED_MIGRATION_PASSWORD@127.0.0.1:5434/cyberguard_incidents?sslmode=disable'

# Explicitly requested demo setup only. Never use these accounts in production.
DEV_EMPLOYEE_A_PASSWORD='REPLACE_WITH_UNIQUE_DEMO_PASSWORD'
DEV_EMPLOYEE_B_PASSWORD='REPLACE_WITH_ANOTHER_DEMO_PASSWORD'
DEV_ANALYST_PASSWORD='REPLACE_WITH_ANALYST_DEMO_PASSWORD'
DEV_ADMIN_PASSWORD='REPLACE_WITH_ADMIN_DEMO_PASSWORD'
