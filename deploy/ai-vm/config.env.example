# Non-secret, literal KEY=value settings; no quotes, substitutions or inline comments.
# Copy to /etc/cyberguard/ai/config.env. manage.sh never sources this as shell code.
AI_PROJECT_NAME=cyberguard-ai-vm
AI_MODEL_DIR=/var/lib/cyberguard-ai/models
AI_SECRETS_DIR=/etc/cyberguard/ai/secrets
AI_SECRET_GID=1000
# Keep loopback until the application's private IP is allowlisted in the Azure NSG.
AI_BIND_IP=127.0.0.1
AI_PORT=8443
AI_NETWORK_APPROVED=no
# Must match a DNS SAN in api.crt; use private DNS or the documented curl --resolve.
AI_TLS_NAME=ai.internal
AI_GO_URL=https://app.internal:8443
# Local release images; build is an explicit operation, never part of up.
AI_IMAGE=cyberguard-ai:azure
AI_KEV_IMAGE=cyberguard-kev:azure
