{
	admin off
	auto_https off
	persist_config off
}

:8443 {
	tls /run/certs/go.crt /run/certs/go.key
	header {
		Cache-Control no-store
		X-Content-Type-Options nosniff
	}
	route {
		@read {
			method GET
			path_regexp private_read ^/(readyz|auth/me|incidents/[0-9a-f-]{36}|internal/ai/jobs/[0-9a-f-]{36}/context)$
		}
		handle @read {
			reverse_proxy go-api:8080
		}
		handle {
			respond 404
		}
	}
}
