# Literal, non-secret KEY=value configuration. Never sourced as shell code.
APP_PROJECT_NAME=cyberguard-app-vm
APP_STATE_DIR=/var/lib/cyberguard-app
APP_SECRETS_DIR=/etc/cyberguard/app/secrets
APP_SECRET_GID=1000
# Safe staging defaults. Approve NSGs/Docker-aware firewall rules before changing bind.
APP_BIND_IP=127.0.0.1
APP_NETWORK_APPROVED=no
APP_HTTP_PORT=80
APP_HTTPS_PORT=443
APP_PRIVATE_PORT=8443
APP_DB_PORT=5432
APP_PUBLIC_NAME=replace.example.invalid
APP_PUBLIC_TLS=acme
APP_GO_TLS_NAME=app.internal
APP_DB_TLS_NAME=incidents.internal
APP_AI_TLS_NAME=ai.internal
APP_AI_IP=10.0.0.5
APP_AI_PORT=8443
# These Docker subnets must not overlap each other, your VNet, VPN or existing networks.
APP_EDGE_SUBNET=172.28.40.0/28
APP_IDENTITY_SUBNET=172.28.41.0/28
APP_INCIDENT_SUBNET=172.28.42.0/28
APP_GO_IMAGE=cyberguard-go:azure
APP_WEB_IMAGE=cyberguard-web:azure
# Enables credential generation/explicit seed only, never seeding during startup.
APP_ALLOW_DEMO_SEED=no
