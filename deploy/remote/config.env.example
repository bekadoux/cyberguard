# Literal workstation settings. Copy to a private file outside Git; never source it.
# SSH targets may be ~/.ssh/config aliases or user@host. Key paths are optional
# when OpenSSH configuration or ssh-agent already selects the right identity.
APP_SSH=operator@app-vm
APP_KEY=
AI_SSH=operator@ai-vm
AI_KEY=
# Pin the full commit ID of this reviewed checkout; blank uses current HEAD.
REVISION=
APP_PUBLIC_NAME=cyberguard.example.org
APP_PRIVATE_IP=10.0.0.4
AI_PRIVATE_IP=10.0.0.5
APP_GO_TLS_NAME=app.internal
APP_DB_TLS_NAME=incidents.internal
AI_TLS_NAME=ai.internal
# CPU threads per model on the AI VM: all Docker CPUs or a positive ceiling.
AI_INFERENCE_THREADS=all
# Approved workstation certificate directory, not the CA private key.
TLS_DIR=
PUBLIC_TLS=acme
# Review against existing Docker, VNet and VPN ranges.
APP_EDGE_SUBNET=172.28.40.0/28
APP_IDENTITY_SUBNET=172.28.41.0/28
APP_INCIDENT_SUBNET=172.28.42.0/28
DEMO_SEED=no
# Separate opt-in for synthetic deployments; requires DEMO_SEED=yes.
DEMO_INCIDENTS=no
# Acknowledge the Azure NSG and Docker-aware firewall review explicitly.
NETWORK_APPROVED=no
