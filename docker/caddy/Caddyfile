{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	header {
		X-Content-Type-Options nosniff
		Cache-Control no-store
	}
	route {
		# Match decoded path segments, including prefixed/duplicate-slash forms.
		@internal path_regexp internal (?i)(^|/)internal(/|$)
		handle @internal {
			header Content-Type application/json
			respond `{"error":{"code":"not_found","message":"Resource not found."}}` 404
		}
		handle /__gateway_health {
			respond "ok" 200
		}
		@go path /api /api/*
		handle @go {
			uri strip_prefix /api
			reverse_proxy go-api:8080 {
				# Go's Location is relative to its unprefixed API contract.
				header_down Location ^(/.*)$ /api$1
			}
		}
		@ai path /ai /ai/*
		handle @ai {
			header Content-Type application/json
			respond `{"error":{"code":"ai_unavailable","message":"AI service is not implemented."}}` 503
		}
		handle {
			header Content-Type application/json
			respond `{"error":{"code":"not_found","message":"Resource not found."}}` 404
		}
	}
}
