{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	header {
		X-Content-Type-Options nosniff
		Cache-Control no-store
	}
	route {
		# Match decoded path segments, including prefixed/duplicate-slash forms.
		@internal path_regexp internal (?i)(^|/)internal(/|$)
		handle @internal {
			header Content-Type application/json
			respond `{"error":{"code":"not_found","message":"Resource not found."}}` 404
		}
		handle /__gateway_health {
			respond "ok" 200
		}
		@go path /api /api/*
		handle @go {
			uri strip_prefix /api
			reverse_proxy go-api:8080 {
				# Go's Location is relative to its unprefixed API contract.
				header_down Location ^(/.*)$ /api$1
			}
		}
		@ai path /ai /ai/*
		handle @ai {
			header Content-Type application/json
			respond `{"error":{"code":"ai_unavailable","message":"AI service is not implemented."}}` 503
		}
		# Only read methods reach static files or SPA fallback, never API mutations.
		@unsupported not method GET HEAD
		handle @unsupported {
			header Allow "GET, HEAD"
			header Content-Type application/json
			respond `{"error":{"code":"method_not_allowed","message":"Method not allowed."}}` 405
		}
		# Cache only existing, fingerprinted Vite assets. Missing assets stay 404/no-store.
		@immutable {
			path_regexp fingerprint ^/assets/.+-[a-zA-Z0-9_-]{8,}\.[a-zA-Z0-9]+$
			file
		}
		handle @immutable {
			header Cache-Control "public, max-age=31536000, immutable"
			encode zstd gzip
			file_server
		}
		handle /assets/* {
			file_server
		}
		@static file
		handle @static {
			encode zstd gzip
			file_server
		}
		# Explicit client routes: source/config/missing-file URLs must not become HTML 200s.
		@spa path / /login /account /incidents /incidents/*
		handle @spa {
			rewrite * /index.html
			encode zstd gzip
			file_server
		}
		handle {
			header Content-Type application/json
			respond `{"error":{"code":"not_found","message":"Resource not found."}}` 404
		}
	}
}
