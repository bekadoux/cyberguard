# Copy to .env and replace the password placeholders locally. Never commit .env.
# Passwords containing reserved URL characters must be percent-encoded.
# This file is a shell-compatible example, not automatically loaded by the API.
HTTP_ADDR=127.0.0.1:8080
IDENTITY_DATABASE_URL='postgres://go_identity:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5433/cyberguard_identity?sslmode=disable'
INCIDENT_DATABASE_URL='postgres://go_incidents:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5434/cyberguard_incidents?sslmode=disable'
DATABASE_TIMEOUT=3s
SHUTDOWN_TIMEOUT=10s
