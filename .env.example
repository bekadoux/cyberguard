# Copy to .env and replace the password placeholders locally. Never commit .env.
# Passwords containing reserved URL characters must be percent-encoded.
# This file is a shell-compatible example, not automatically loaded by the API.
HTTP_ADDR=127.0.0.1:8080
IDENTITY_DATABASE_URL='postgres://go_identity:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5433/cyberguard_identity?sslmode=disable'
INCIDENT_DATABASE_URL='postgres://go_incidents:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5434/cyberguard_incidents?sslmode=disable'
# Alternatively remove the two direct URL settings and set their _FILE variants.
# See docs/docker-setup.md for generated runtime_host_url files and Docker commands.
DATABASE_TIMEOUT=3s
SHUTDOWN_TIMEOUT=10s

# Local HTTP development only. Production defaults are secure when unset.
APP_ENV=development
SESSION_COOKIE_SECURE=false
TRUSTED_ORIGINS='http://127.0.0.1:5173'
SESSION_LIFETIME=8h
SESSION_IDLE_TIMEOUT=30m
# Leave unset for direct connections. Configure only the actual ingress IP/CIDR.
# TRUSTED_PROXY_CIDRS='10.0.0.2/32'
